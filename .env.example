# Supabase Dashboard > Project Settings > API. Never commit .env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only; used to update the read-only projection of AI-confirmed records.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
# Opt-in synthetic-data testing only; accepted by loopback npm run dev, never Vercel.
LOCAL_TEST_MODE=false
# Optional online pilot banner; never bypasses PRIVACY_NOTICE_READY or consent.
PUBLIC_PILOT_MODE=false

# Login uses Supabase Auth (Google provider). Configure it in the Supabase
# dashboard; see docs/SUPABASE_LOGIN.md. No extra variables are needed.

# AI on the same Mac for local development; HTTPS private gateway on Vercel.
RUAMWAN_BASE_URL=http://127.0.0.1:8765
# Always-on cloud record service (aimuge in cloud mode on Vercel). When set,
# records/plans/food energy/journal parsing go here; only chat and extract
# still need the Mac model (RUAMWAN_GATEWAY_URL / RUAMWAN_BASE_URL).
RUAMWAN_CORE_URL=
# Optional HTTPS gateway; when present this takes precedence over BASE_URL.
RUAMWAN_GATEWAY_URL=
RUAMWAN_API_KEY=
# Local only: optional absolute path to the existing AI key; never used on Vercel.
RUAMWAN_API_KEY_FILE=
# Optional Cloudflare Access service-token authentication for a private gateway.
AI_GATEWAY_CLIENT_ID=
AI_GATEWAY_CLIENT_SECRET=

# Set true only after the privacy notice, operator and retention are reviewed.
PRIVACY_NOTICE_READY=false
DATA_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
# Optional alternative to email: a real LINE/phone/support contact, displayed as text.
PRIVACY_CONTACT=
DATA_RETENTION_NOTICE=
DATA_LOCATION_NOTICE=
