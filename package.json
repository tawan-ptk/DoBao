{
  "name": "dobao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "setup:check": "node --env-file-if-exists=.env.local scripts/check-setup.mjs",
    "test:rls": "node --env-file-if-exists=.env.local scripts/test-rls.mjs",
    "check": "node --check script.js && node --check api/index.js && npm test && npm run build",
    "release:check": "npm run check && npm run setup:check -- --production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cookie": "^1.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10"
  }
}
